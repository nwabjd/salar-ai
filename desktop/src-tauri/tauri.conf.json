{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SALAR",
  "version": "1.0.0",
  "identifier": "ai.salar.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [{
      "title": "SALAR — Personal Intelligence",
      "width": 1440,
      "height": 900,
      "minWidth": 960,
      "minHeight": 640,
      "fullscreen": false,
      "decorations": false,
      "resizable": true,
      "additionalBrowserArgs": "--disable-features=ServiceWorker,msWebOOUI,msPdfOOUI,msSmartScreenProtection"
    }],
    "withGlobalTauri": true,
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https: wss:; font-src 'self' data:" }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["salar"] } }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"],
    "windows": { "nsis": { "installMode": "currentUser", "displayLanguageSelector": false } }
  }
}
