# SALAR Backend Production Environment Variables
# Copy to .env and fill in values

# Security
SALAR_ENVIRONMENT=production
SALAR_JWT_SECRET=<generate-random-secret>
SALAR_BOOTSTRAP_EMAIL=owner@salar.local
SALAR_BOOTSTRAP_PASSWORD=ChangeMeImmediately!
SALAR_PROVISIONING_KEY=salar-local-setup

# Gemini AI
SALAR_GEMINI_API_KEY=<your-gemini-api-key>
SALAR_GEMINI_MODEL=gemini-3.1-flash-lite

# CORS
SALAR_ALLOWED_ORIGINS=["https://salaar.cloud","https://www.salaar.cloud","https://api.salaar.cloud"]

# Public URL
SALAR_PUBLIC_API_URL=https://api.salaar.cloud

# WhatsApp Bridge
WA_BRIDGE_PORT=3100
SALAR_BACKEND_URL=http://127.0.0.1:8000
SALAR_BRIDGE_URL=http://127.0.0.1:3100
