# SALAR Backend Environment Variables
# Copy to .env and fill in values. All keys use the SALAR_ prefix.

# --- Environment / security ---
# "production" disables the dev-only bootstrap seed and developer auth paths.
SALAR_ENVIRONMENT=production
# Secret used to sign backend-issued access tokens (the app-user JWT).
SALAR_JWT_SECRET=<generate-random-secret>
# Data-at-rest encryption key for /api/vault (Fernet). REQUIRED in production:
# the vault fails closed (no default key) when this is unset.
SALAR_VAULT_KEY=<generate-a-fernet-key>

# --- Supabase (only login method in production) ---
# Project URL, e.g. https://abcdefgh.supabase.co
SALAR_SUPABASE_URL=<your-supabase-project-url>
# OPTIONAL: JWT secret from Supabase Dashboard -> Settings -> API.
# Only used to verify legacy HS256-signed tokens. Current Supabase access
# tokens are ES256 and are verified against the project's JWKS endpoint,
# which is derived from SALAR_SUPABASE_URL (no secret needed).
SALAR_SUPABASE_JWT_SECRET=
# Access-token audience issued by Supabase. Default "authenticated" unless changed.
SALAR_SUPABASE_AUDIENCE=authenticated
# Comma-free JSON list of emails that get admin access to /api/monitor and /api/alerts.
SALAR_ADMIN_EMAILS=["owner@example.com"]

# --- Dev only: bootstrap owner user (ignored when SALAR_ENVIRONMENT=production) ---
SALAR_BOOTSTRAP_EMAIL=owner@salar.local
SALAR_BOOTSTRAP_PASSWORD=ChangeMeImmediately!

# --- Gemini AI ---
SALAR_GEMINI_API_KEY=<your-gemini-api-key>
SALAR_GEMINI_MODEL=gemini-3.1-flash-lite

# --- CORS ---
SALAR_ALLOWED_ORIGINS=["https://salaar.cloud","https://www.salaar.cloud"]

# --- Public URL ---
# The verified production API origin (Render service). api.salar.cloud / api.salaar.cloud do NOT resolve.
SALAR_PUBLIC_API_URL=https://salar-backend.onrender.com

# --- Monthly message quotas ---
SALAR_FREE_MONTHLY_QUOTA=500
SALAR_PRO_MONTHLY_QUOTA=5000

# --- Billing (wallet/PayPal/Stripe) ---
# Wallet address that receives crypto payments for the Pro plan.
SALAR_PAYMENT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
# Optional PayPal REST app (client id + secret) for PayPal checkout.
SALAR_PAYPAL_CLIENT_ID=<your-paypal-client-id>
SALAR_PAYPAL_SECRET=<your-paypal-secret>
# Optional Stripe keys + price ids (used only if you enable Stripe in billing.py).
SALAR_STRIPE_SECRET_KEY=
SALAR_STRIPE_WEBHOOK_SECRET=
SALAR_STRIPE_PRICE_PRO=
SALAR_STRIPE_PRICE_TEAM=

# --- WhatsApp Bridge ---
# Port the WhatsApp bridge (backend/whatsapp/bridge.js) listens on.
WA_BRIDGE_PORT=3100
# URL the bridge uses to call the backend (register sessions, relay messages).
SALAR_BACKEND_URL=http://127.0.0.1:8000
# Public URL of the bridge, used by the backend to reach bridge endpoints.
SALAR_BRIDGE_URL=http://127.0.0.1:3100
# Where WhatsApp auth state (qr/session files) is stored. Per-user under this dir.
WA_AUTH_DIR=./auth
# Shared secret the bridge sends as X-WhatsApp-Secret so the backend accepts
# /api/whatsapp/webhook calls. MUST match SALAR_WHATSAPP_WEBHOOK_SECRET on the
# backend; the backend rejects webhooks without a valid secret.
SALAR_WHATSAPP_WEBHOOK_SECRET=<generate-random-secret>
# Bridge sessions are per-user: send the caller's app-user JWT in the
# X-User-Id header so the bridge keys QR/auth state per account.

# --- WhatsApp Customer Service (official Meta WhatsApp Business Platform) ---
# Capability flag + env-only credentials for the business customer-service
# inbox (/api/whatsapp-cs/*). These NEVER leave the server: they are not
# returned by any API and are never written to the database.
# Webhook URL: https://<your-backend>/api/whatsapp-cs/webhook
#   - VERIFY token: any non-empty secret you choose (must match the value you
#     enter when subscribing the webhook in Meta / WhatsApp Manager).
#   - App secret: from Meta App Dashboard -> App settings -> Basic.
#   - Access token: a permanent WABA token with the whatsapp_business_messaging
#     and whatsapp_business_management permissions.
#   - Phone number ID / Business account ID: WhatsApp Manager -> API Setup.
SALAR_WHATSAPP_CS_ENABLED=false
SALAR_WHATSAPP_CS_ACCESS_TOKEN=<your-whatsapp-cloud-api-access-token>
SALAR_WHATSAPP_CS_PHONE_NUMBER_ID=<your-phone-number-id>
SALAR_WHATSAPP_CS_BUSINESS_ACCOUNT_ID=<your-waba-id>
SALAR_WHATSAPP_CS_VERIFY_TOKEN=<your-webhook-verify-token>
SALAR_WHATSAPP_CS_APP_SECRET=<your-meta-app-secret>
# Graph API version for the Cloud API. Keep it on a currently supported stable
# version (see Meta's Graph API changelog).
SALAR_WHATSAPP_CS_API_VERSION=v23.0
# AI defaults for the customer-service agent (overridable from the dashboard,
# which stores only non-secret preferences in the database).
SALAR_WHATSAPP_CS_AI_ENABLED=true
SALAR_WHATSAPP_CS_AI_MODEL=
SALAR_WHATSAPP_CS_DEFAULT_FALLBACK=Thank you for reaching out. Our team has been notified and will get back to you shortly.

# --- Rate limiting ---
# Maps to Settings.rate_limit_default in backend/app/config.py.
# NOTE: not currently enforced. Enforced limits today are per-endpoint:
# auth 5/min, auth relay and devices 10/min. Adding this as a global
# default would require careful handling of the /ws/live WebSocket and
# long-running streaming endpoints.
SALAR_RATE_LIMIT=60/minute

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
SALAR_LOG_LEVEL=INFO

# --- CORS regex (optional) ---
# Regex for allowed CORS origins. Leave empty to use the explicit list only.
# Maps to Settings.cors_allow_origin_regex in backend/app/config.py.
SALAR_CORS_ALLOW_ORIGIN_REGEX=
