SALAR_ENVIRONMENT=production
SALAR_DATABASE_URL=sqlite:////data/salar.db
SALAR_JWT_SECRET=replace-with-at-least-64-random-characters
SALAR_BOOTSTRAP_EMAIL=owner@example.com
SALAR_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
SALAR_ALLOWED_ORIGINS=["https://salar.example.com"]
SALAR_STORAGE_DIR=/data/uploads
SALAR_OLLAMA_BASE_URL=http://host.docker.internal:11434
SALAR_OLLAMA_DEFAULT_MODEL=salar-gemma4-e2b
# External MCP servers SALAR's agent can call (mcp_tools / mcp_call tools).
SALAR_MCP_SERVERS=[]
# Identity used by `python -m app.mcp_server` (SALAR as an MCP server).
# When unset, falls back to the first user in the database.
#SALAR_MCP_USER_ID=
SALAR_PUBLIC_API_URL=https://salar-backend.onrender.com
# Data-at-rest encryption key for /api/vault (Fernet). Required in production.
SALAR_VAULT_KEY=replace-with-a-generated-fernet-key
# Shared secret between the WhatsApp bridge and the backend webhook.
SALAR_WHATSAPP_WEBHOOK_SECRET=replace-with-a-random-secret
# n8n workflow automation: SALAR's agent drives a *separate, self-hosted* n8n
# instance over its public REST API (X-N8N-API-KEY). Point these at either a
# local Docker sidecar (docker/docker-compose.n8n.yml, 127.0.0.1:5678) or a
# hosted instance. Per-user instances can also be connected via POST /api/n8n/connect.
#SALAR_N8N_BASE_URL=http://127.0.0.1:5678
#SALAR_N8N_API_KEY=replace-with-a-key-from-Settings-n8n-API
