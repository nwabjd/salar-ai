# Copy to .env.local and fill in real values to activate Supabase sign-in on the
# landing page. Without these the landing page runs in preview mode (signup flow
# still works with code 123456).
# Required in production for the chat dashboard to work.
# Find both under Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Backend API base URL used by the web client (must match backend CORS allowlist).
# Optional; defaults to https://salar-backend.onrender.com.
# VITE_API_URL=https://salar-backend.onrender.com
